{
  "name": "notify-queue",
  "version": "1.0.0",
  "description": "BullMQ notification queue (email / in-app message) with automatic retries, max attempts and dead-letter queue, plus a small Express management API.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}